{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "log_split.json",
  "description": "The test and non-test logs, and the first and last time of the test span.",
  "type": "object",
  "properties": {
    "non_test": {
      "description": "The non-test logs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test": {
      "description": "The test logs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_start": {
      "description": "The first time of the test span, in epoch seconds.",
      "type": "number"
    },
    "test_end": {
      "description": "The last time of the test span, in epoch seconds.",
      "type": "number"
    }
  },
  "required": [
    "non_test",
    "test",
    "test_start",
    "test_end"
  ],
  "additionalProperties": false
}
