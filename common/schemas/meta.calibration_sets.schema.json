{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calibration_sets/<time>/meta.json",
  "description": "Where a calibration set came from.",
  "allOf": [
    {
      "$ref": "meta.schema.json"
    }
  ],
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "log_split": {
          "description": "The `log_splits/<time>` directory.",
          "type": "string",
          "pattern": "^log_splits/[0-9]{8}-[0-9]{6}$"
        },
        "calibration": {
          "description": "Share of the training seconds above `min_speed` held out to set thresholds.",
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "block": {
          "description": "Seconds above `min_speed` in one calibration block.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gap": {
          "description": "Seconds of rows dropped around the test span.",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "log_split",
        "calibration",
        "block",
        "gap"
      ],
      "additionalProperties": false
    },
    "log_split": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The log split whose non-test logs it was cut from."
    },
    "grid": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The grid the split was cut from."
    }
  },
  "required": [
    "log_split",
    "grid"
  ],
  "unevaluatedProperties": false
}
