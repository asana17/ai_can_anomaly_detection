{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_sets/<time>/meta.json",
  "description": "Where a test set came from.",
  "allOf": [
    {
      "$ref": "meta.schema.json"
    }
  ],
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "log_split": {
          "description": "The `log_splits/<time>` directory.",
          "type": "string",
          "pattern": "^log_splits/[0-9]{8}-[0-9]{6}$"
        },
        "seed": {
          "description": "The seed the attacks are drawn with.",
          "type": "integer"
        },
        "donors": {
          "description": "Training logs the replayed payloads are taken from.",
          "type": "integer",
          "minimum": 1
        },
        "attack": {
          "description": "The kind of attack injected into every test log.",
          "enum": [
            "replay",
            "matched_replay"
          ]
        }
      },
      "required": [
        "log_split",
        "seed",
        "donors",
        "attack"
      ],
      "additionalProperties": false
    },
    "log_split": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The log split whose test logs were attacked."
    },
    "grid": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The grid the split was cut from."
    }
  },
  "required": [
    "log_split",
    "grid"
  ],
  "unevaluatedProperties": false
}
