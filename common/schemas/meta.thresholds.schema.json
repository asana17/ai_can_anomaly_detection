{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thresholds/<time>/meta.json",
  "description": "Where thresholds came from.",
  "allOf": [
    {
      "$ref": "meta.schema.json"
    }
  ],
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "models": {
          "description": "The `models/<time>` directory.",
          "type": "string",
          "pattern": "^models/[0-9]{8}-[0-9]{6}$"
        },
        "target": {
          "$ref": "meta.schema.json#/$defs/target"
        },
        "onnx_files": {
          "description": "The `onnx/<time>` or `quantize/<time>` directory the models scored as, or null for torch.",
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "description": "The precision of those ONNX files, or null for torch.",
          "enum": [
            "float",
            "int8",
            null
          ]
        }
      },
      "required": [
        "models",
        "target",
        "onnx_files",
        "precision"
      ],
      "additionalProperties": false
    },
    "models": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The directory the models came from."
    },
    "onnx_files": {
      "$ref": "meta.schema.json#/$defs/onnx_files"
    },
    "train_set": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The train set the rows came from, as the fit records it."
    },
    "split": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The split, as the fit records it."
    },
    "grid": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The grid, as the fit records it."
    },
    "min_speed": {
      "$ref": "meta.schema.json#/$defs/min_speed",
      "description": "The speed a row had to exceed to set a threshold."
    },
    "rows": {
      "description": "How many rows each threshold was taken from.",
      "type": "integer",
      "minimum": 0
    },
    "versions": {
      "$ref": "meta.schema.json#/$defs/versions",
      "description": "Python, NumPy, the platform, and torch or ONNX Runtime, whichever scored."
    }
  },
  "required": [
    "models",
    "onnx_files",
    "train_set",
    "split",
    "grid",
    "min_speed",
    "rows",
    "versions"
  ],
  "unevaluatedProperties": false
}
