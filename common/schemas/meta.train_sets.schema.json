{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "train_sets/<time>/meta.json",
  "description": "Where a train set came from.",
  "allOf": [
    {
      "$ref": "meta.schema.json"
    }
  ],
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "calibration_set": {
          "description": "The `calibration_sets/<time>` directory.",
          "type": "string",
          "pattern": "^calibration_sets/[0-9]{8}-[0-9]{6}$"
        },
        "gap": {
          "description": "Seconds of rows dropped around the test span and every calibration block.",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "calibration_set",
        "gap"
      ],
      "additionalProperties": false
    },
    "calibration_set": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The calibration set whose blocks the train rows keep away from."
    },
    "log_split": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The log split, as the calibration set records it."
    },
    "grid": {
      "$ref": "meta.schema.json#/$defs/directory",
      "description": "The grid the split was cut from."
    }
  },
  "required": [
    "calibration_set",
    "log_split",
    "grid"
  ],
  "unevaluatedProperties": false
}
