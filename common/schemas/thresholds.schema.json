{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thresholds.json",
  "description": "One entry per model, the model as the fit records it and `threshold`.",
  "type": "array",
  "items": {
    "$ref": "model.schema.json",
    "properties": {
      "threshold": {
        "description": "The model's score at `TARGET`.",
        "type": "number"
      }
    },
    "required": [
      "threshold"
    ],
    "unevaluatedProperties": false
  }
}
