    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_TOOL_ARGUMENTS" value="-c &quot;export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH PYTHONUNBUFFERED=1; .venv/bin/python -m board.application.ai_can_anomaly_detection.send_test_frames part_3/20210204110654673616.csv --frames guidelines/window_alarm.parquet | tee received_frames.txt | .venv/bin/python -m board.application.ai_can_anomaly_detection.board_frames - | grep --line-buffered -E 'alarm (start|end)|frames stored'&quot;"/>
