<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.ui.externaltools.ProgramLaunchConfigurationType">
    <booleanAttribute key="org.eclipse.debug.ui.ATTR_LAUNCH_IN_BACKGROUND" value="false"/>
    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_LOCATION" value="/bin/sh"/>
    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_TOOL_ARGUMENTS" value='-c "export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH PYTHONUNBUFFERED=1; command -v uv &gt;/dev/null || curl -LsSf https://astral.sh/uv/install.sh | sh; [ -d .venv ] || uv venv --python 3.9 .venv; uv pip install --python .venv/bin/python -r requirements.txt; [ $(uname) != Darwin ] || brew install libusb"'/>
    <stringAttribute key="org.eclipse.ui.externaltools.ATTR_WORKING_DIRECTORY" value="${project_loc:/ai_can_anomaly_detection}/../.."/>
</launchConfiguration>
